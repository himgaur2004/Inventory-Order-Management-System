# Root-level .dockerignore
# Prevents the Docker build daemon from sending unnecessary files when building
# from the project root (e.g. `docker compose build`).

# Version control
.git/
.gitignore
.github/

# Environment files — never bake secrets into images
.env
.env.*
!.env.example

# Documentation
*.md
docs/

# Editor / OS artifacts
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
venv/
.venv/

# Node artifacts
node_modules/
frontend/dist/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/

# Logs
*.log
